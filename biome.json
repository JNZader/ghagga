{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.next", "!*.min.js", "!pnpm-lock.yaml", "!packages/db/drizzle/meta"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useArrowFunction": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnsafeOptionalChaining": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noAssignInExpressions": "warn",
        "noImplicitAnyLet": "warn",
        "noArrayIndexKey": "warn",
        "noNonNullAssertedOptionalChain": "warn",
        "noUnknownAtRules": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useButtonType": "warn",
        "noLabelWithoutControl": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/__tests__/**",
        "**/__integration__/**",
        "**/test/**"
      ],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/forge/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "useImportType": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@ghagga/server": "packages/forge MUST NOT import the server app (R-AGNOSTIC).",
                  "ghagga-server": "packages/forge MUST NOT import the server app (R-AGNOSTIC)."
                },
                "patterns": [
                  {
                    "group": ["**/apps/server/**", "../**/apps/server/**"],
                    "message": "packages/forge MUST NOT import apps/server (R-AGNOSTIC)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "ghagga-forge": "ghagga-core MUST NOT import ghagga-forge — core stays forge-agnostic (R-AGNOSTIC)."
                },
                "patterns": [
                  {
                    "group": ["**/packages/forge/**", "../forge/**", "../**/packages/forge/**"],
                    "message": "ghagga-core MUST NOT import packages/forge (R-AGNOSTIC)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
