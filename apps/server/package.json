{
  "name": "@ghagga/server",
  "version": "2.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutate": "stryker run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@octokit/rest": "^22.0.1",
    "bullmq": "^5.76.10",
    "dotenv": "^17.4.2",
    "ghagga-core": "workspace:*",
    "ghagga-db": "workspace:*",
    "hono": "^4.12.21",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.10.1",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.22.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.7"
  }
}
