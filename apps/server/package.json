{
  "name": "@ghagga/server",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutate": "stryker run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "memory:backfill": "tsx scripts/backfill-embeddings.ts"
  },
  "dependencies": {
    "@ghagga/types": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@octokit/rest": "^22.0.1",
    "bullmq": "^6.3.8",
    "dotenv": "^18.0.3",
    "ghagga-core": "workspace:*",
    "ghagga-db": "workspace:*",
    "ghagga-forge": "workspace:*",
    "hono": "^4.13.9",
    "hono-rate-limiter": "^0.5.4",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
