{
  // Typecheck-only config that also covers scripts/ (the memory:backfill admin
  // script lives outside the build's rootDir: ./src and is invisible to the
  // plain `tsc --noEmit`). noEmit — this never produces dist output.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
