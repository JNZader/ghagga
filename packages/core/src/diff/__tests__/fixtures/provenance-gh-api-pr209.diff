+        lastSignificant = '/'; // regex is an expression value
+        i = j;
+        continue;
+      }
+      // Not actually a regex (no closing slash on this line): treat as division.
+      emit(ch);
+      i++;
+      continue;
+    }
+
+    emit(ch);
+    i++;
+  }
+
+  return out.join('');
+}
