+    // Regex literal (only when context says a `/` cannot be division).
+    if (ch === '/' && regexAllowedAfter(lastSignificant)) {
+      let j = i + 1;
+      let inClass = false;
+      let closed = false;
+      while (j < n) {
+        const c = src[j];
+        if (c === '\\') {
