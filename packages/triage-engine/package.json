{
  "name": "ghagga-triage-engine",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Config-driven code-aware issue triage and reproduction engine for GHAGGA",
  "author": "JNZader",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JNZader/ghagga.git",
    "directory": "packages/triage-engine"
  },
  "homepage": "https://github.com/JNZader/ghagga#readme",
  "bugs": {
    "url": "https://github.com/JNZader/ghagga/issues"
  },
  "keywords": [
    "ghagga",
    "triage",
    "issue-triage",
    "ai",
    "reproduction"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ghagga-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
